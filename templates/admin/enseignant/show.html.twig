{% extends 'base.html.twig' %}

{% block title %}Détail d'un Enseignant{% endblock %}

{% block link %} <link rel="icon" href="{{ asset('icons/prof.ico') }}"> {% endblock %}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 droid-sérif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Enseignant</h1>
    {% if enseignant is not null %}
    <div class="card mb-1 m-auto">
        <div class="card-body">
            <div class="card-title d-flex justify-content-between">
                <h4 class="mb-1">{{ enseignant.nomPrenom }}</h4>
                    <small class="text-muted">Identifiant : {{ enseignant.id }}</small>
            </div>
            <div class="d-flex justify-content-between card-text">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Matricule : {{ enseignant.matricule }}</li>
                    <li class="list-group-item">Grade : {{ enseignant.grade.value }}</li>
                    <li class="list-group-item">Email : {{ enseignant.mail }}</li>
                    <li class="list-group-item">Contact : {{ enseignant.contact }}</li>
                </ul>
            </div>
        </div>
    </div>
    {% else %}
        <div>Enseignant non trouvé</div>
    {% endif %}
    <a href="{{ path('app_admin_enseignant_show_ues', {id : enseignant.id}) }}" class="btn btn-primary">Voir la liste des Ues</a>
    <a href="{{ path('app_admin_enseignant_list') }}" class="btn btn-primary">Retourner à la liste des enseignants</a>
</div>
{% endblock %}
