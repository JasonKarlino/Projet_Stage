{% extends 'base.html.twig' %}

{% block title %}Liste des Enseignants{% endblock %}
{% block link %} <link rel="icon" href="{{ asset('icons/liste.ico') }}"> {% endblock %}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 droid-sérif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Liste des Enseignants</h1>
    <ul class="list-group list-group-flush">
        {% for enseignant in enseignants %}
            <div class="card mb-1">
                <div class="card-body">
                    <div class="card-title d-flex justify-content-between">
                        <a href="{{ path('app_admin_enseignant_show', {id: enseignant.id}) }}" class="stretched-link link-blue">
                            <h4 class="mb-1">{{ enseignant.nomPrenom }}</h4>
                        </a>
                        <small class="text-muted">Identifiant : {{ enseignant.id }}</small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </ul> 
</div>
{% endblock %}
