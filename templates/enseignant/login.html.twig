{% extends 'base.html.twig' %}

{% block title %}Connexion enseignant{% endblock %}
{% block link %}<link rel="icon" href="{{ asset('icons/connexion.ico') }}">{% endblock %}
       
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 droid-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Connexion Enseignant</h1>

    {% if error %}
        <div style="background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 24px; border: 1px solid #f5c6cb; text-align: center;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" style="max-width: 400px; margin: 0 auto; text-align: left;">
        <div style="margin-bottom: 20px;">
            <label for="mail" style="display: block; margin-bottom: 6px; font-weight: 600; color: #333;">Email :</label>
            <input type="email" 
                id="mail" 
                name="mail" 
                value="{{ last_username ?? '' }}" 
                required 
                style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; box-sizing: border-box; font-family: 'Droid Serif', serif;">
        </div>

        <div style="margin-bottom: 20px;">
            <label for="motDePasse" style="display: block; margin-bottom: 6px; font-weight: 600; color: #333;">Mot de passe :</label>
            <input type="password" 
                id="motDePasse" 
                name="motDePasse" 
                required 
                style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; box-sizing: border-box; font-family: 'Droid Serif', serif;">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" 
                style="width: 100%; padding: 12px; background-color: #007bff; color: white; border: none; border-radius: 6px; font-size: 16px; font-weight: 600; cursor: pointer; font-family: 'Droid Serif', serif;">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}
