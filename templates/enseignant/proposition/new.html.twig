{% extends 'base.html.twig' %}

{% block title %}Ajout de Proposition{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout de proposition</h1>

    {{ form_start(form) }}
    {{ form_row(form.libelle, {label : 'Libéllé'}) }}
    {{ form_row(form.estVraie, {label : 'Est vraie'}) }}
    {{ form_end(form) }}


</div>
{% endblock %}
