{% extends 'base.html.twig' %}

{% block title %}Ajout d'UE{% endblock %}
{% block link %} <link rel="icon" href="{{ asset('icons/pile-de-livres.ico') }}"> {% endblock %}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 georgia; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout d'Unités d'Enseignements(UE)</h1>

    {{ form_start(form) }}
    {{ form_row(form.code, {label: 'Code dUE'}) }}
    {{ form_row(form.intitule, {label: 'Intitulé'}) }}
    {{ form_row(form.nbreCredits) }}
    {{ form_row(form.semestre) }}
    {{ form_row(form.annee) }}
    {{ form_end(form) }}
  
</div>
{% endblock %}
