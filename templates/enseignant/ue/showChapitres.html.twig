{% extends 'base.html.twig' %}

{% block title %}Liste des chapitres de l'Ue : {{ue.code}} {% endblock %}
{% block link %} <link rel="icon" href="{{ asset('icons/liste.ico') }}"> {% endblock %}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 droid-sérif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Liste des chapitres de l'Ue : {{ue.code}}</h1>
    <ul class="list-group list-group-flush">
        {% for chapitre in ue.chapitres %}
            <div class="card mb-1">
                <div class="card-body">
                    <div class="card-title d-flex justify-content-between">
                        <a href="{{ path('app_enseignant_chapitre_show', {id: chapitre.id}) }}" class="stretched-link link-blue">
                            <h4 class="mb-1">{{ chapitre.titre }}</h4>
                        </a>
                        <small class="text-muted">Identifiant : {{ chapitre.id }}</small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </ul> 
      <a href="{{ path('app_enseignant_ue_show', {id : ue.id}) }}" class="btn btn-primary">Retourner à l'UE</a>
</div>
{% endblock %}
