{% extends 'base.html.twig' %}

{% block title %}Détail de l'UE {{ue.code}}{% endblock %}
{% block link %} <link rel="icon" href="{{ asset('icons/pile-de-livres.ico') }}"> {% endblock %}
{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 droid-sérif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>UE : </h1>
    {% if ue is not null %}
    <div class="card mb-1 m-auto">
        <div class="card-body">
            <div class="card-title d-flex justify-content-between">
                <h4 class="mb-1">{{ ue.code }}</h4>
                    <small class="text-muted">Identifiant : {{ ue.id }}</small>
            </div>
            <div class="d-flex justify-content-between card-text">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Intitulé : {{ ue.intitule }}</li>
                    <li class="list-group-item">Nombre de crédits : {{ ue.nbreCredits }}</li>
                    <li class="list-group-item">Semestre : {{ ue.semestre }}</li>
                    <li class="list-group-item">Année : {{ ue.annee }}</li>
                </ul>
            </div>
        </div>
    </div>
    {% else %}
        <div>UE non trouvé</div>
    {% endif %}
    <a href="{{ path('app_enseignant_ue_show_chapitres', {id : ue.id}) }}" class="btn btn-primary">Voir la liste des chapitres</a>
    <a href="{{ path('app_enseignant_ue_list') }}" class="btn btn-primary">Retour à la liste des Ues</a>
</div>
{% endblock %}
