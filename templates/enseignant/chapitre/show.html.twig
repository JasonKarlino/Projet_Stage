{% extends 'base.html.twig' %}

{% block title %}Détail du chapitre {{chapitre.id}}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 droid-sérif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Chapitre : </h1>
    {% if chapitre is not null %}
    <div class="card mb-1 m-auto">
        <div class="card-body">
            <div class="card-title d-flex justify-content-between">
                <h4 class="mb-1">{{ chapitre.titre }}</h4>
                    <small class="text-muted">Identifiant : {{ chapitre.id }}</small>
            </div>
            <div class="d-flex justify-content-between card-text">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>Contenu du chapitre :</strong>
                        <div class="mt-2 p-2 bg-light rounded" style="white-space: pre-wrap; word-wrap: break-word;">{{ chapitre.contenu }}</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    {% else %}
        <div>Chapitre non trouvé</div>
    {% endif %}
    <a href="{{ path('app_enseignant_ue_show_chapitres', {id : chapitre.ue.id}) }}" class="btn btn-primary">Retour à la liste des chapitres</a>
</div>
{% endblock %}
