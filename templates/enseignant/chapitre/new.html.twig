{% extends 'base.html.twig' %}

{% block title %}Ajout de Chapitre{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 droid-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout de Chapitre</h1>

    {{ form_start(form) }}
    {{ form_row(form.titre, {label: 'Titre'}) }}
    {{ form_row(form.contenu, {label: 'Contenu'}) }}
    {{ form_row(form.ue, {label: 'UE'}) }}
    {{ form_end(form) }}
    
</div>
{% endblock %}
